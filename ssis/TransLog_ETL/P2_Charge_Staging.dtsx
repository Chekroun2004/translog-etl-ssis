                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    TRY_CAST(id_expedition AS INT)       AS expedition_id,
    TRY_CAST(id_client AS INT)           AS id_client,
    TRY_CAST(id_entrepot AS INT)         AS id_entrepot,
    TRY_CAST(id_transporteur AS INT)     AS id_transporteur,
    TRY_CAST(date_expedition AS DATE)    AS date_expedition,
    LTRIM(RTRIM(statut))                 AS statut,
    TRY_CAST(poids_kg AS DECIMAL(10,2))  AS poids_kg,
    TRY_CAST(volume_m3 AS DECIMAL(10,2)) AS volume_m3,
    TRY_CAST(delai_prevu_jours AS INT)   AS delai_prevu_jours,
    TRY_CAST(delai_reel_jours AS INT)    AS delai_reel_jours,
    ROW_NUMBER() OVER (PARTITION BY id_expedition
                       ORDER BY (SELECT NULL)) AS rn
FROM stg.expeditions</property>
